# GOON Beverage Site — environment template.
#
# Copy this to `.env` at the repo ROOT on the Nucleus host and fill in real
# values. `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# NOTE: the existing dev secrets live in app/.env. For the container, compose
# reads `.env` at the repo root (env_file: .env). DB_PATH is injected by
# docker-compose.yml (-> /data/beverage.db) and must NOT be set here.

# --- Grocy (inventory) -------------------------------------------------------
# Base URL of your Grocy instance. With or without a trailing /api — the client
# normalizes it. e.g. https://grocy.example.ts.net  or  http://192.168.1.10:9283
GROCY_URL=https://grocy.example.invalid

# Grocy API key (Grocy -> Settings -> Manage API keys).
GROCY_API_KEY=replace-with-grocy-api-key

# --- Notion (recipes) --------------------------------------------------------
# Internal integration secret (https://www.notion.so/my-integrations).
NOTION_API_KEY=secret_replace-with-notion-integration-token

# The Notion database ID for the Crafted Drinks DB (32-char hex, dashes ok).
NOTION_CRAFTED_DRINKS_DB_ID=replace-with-notion-database-id
